DATABASE_URL="postgresql://perch:perch@localhost:5432/perch?schema=public"
# If using the Vercel Supabase integration, Perch also supports POSTGRES_PRISMA_URL,
# POSTGRES_URL, POSTGRES_URL_NON_POOLING, or SUPABASE_DB_URL as database aliases.
APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_a_random_auth_secret"
ADMIN_BASIC_USERNAME="admin@example.com"
ADMIN_BASIC_PASSWORD="replace_with_a_strong_password"
CAFE_LOGIN_EMAIL="owner@example.com"
CAFE_LOGIN_PASSWORD="replace_with_a_strong_cafe_password"
CAFE_SESSION_SECRET="replace_with_a_random_cafe_session_secret"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_placeholder"
SUPABASE_SECRET_KEY="sb_secret_placeholder_server_only"
# Vercel Supabase integration aliases also work:
# SUPABASE_ANON_KEY="anon_placeholder"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="anon_placeholder"
# SUPABASE_SERVICE_ROLE_KEY="service_role_placeholder_server_only"

STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET_CONNECT="whsec_placeholder"
STRIPE_CONNECT_CLIENT_ID="ca_placeholder"
STRIPE_MOCK_CHECKOUT="true"
DEMO_TOOLS_ENABLED="false"
HOSTED_PREVIEW_DEMO_ENABLED="false"

APP_MAC_PEPPER="replace_with_a_32_byte_random_pepper"
FIELD_ENCRYPTION_KEY="replace_with_32_random_bytes_base64_or_hex"
VOUCHER_CODE_SECRET="replace_with_a_random_voucher_hmac_secret"

NETWORK_PROVIDER_MODE="mock"
WORKER_POLL_INTERVAL_SECONDS="5"
